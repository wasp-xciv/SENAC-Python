# # #Criar um menu:
option = ""
nomes_clientes = []
telefone_clientes = []

while option != "0":
    print("=== MENU CLIENTE ===\n1 - Cadastrar cliente\n2 - Listar cliente\n3 - Editar cliente\n4 - Excluir cliente\n0 - Sair")
    option = input("\nEscolha uma opção: ")
    if option == "1":
        print("\n1 - Cadastrar cliente")

        nome = input("Digite o nome do cliente: ")
        telefone = input("Digite o telefone: ")

        if nome == "":
            print("=== Nome não pode ser vazio (；′⌒`) ===")

        else:
            nomes_clientes.append(nome)
            telefone_clientes.append(telefone)
            print("\n=== Cliente cadastrado com sucesso! ☆*: .｡. o(≧▽≦)o .｡.:*☆ ===") #Windows + . é o comando que puxa emojis, gifs, etc
        print()

    elif option == "2": #essa seção trabalhará com o len da lista
        print("\n2 - Listar cliente:")
        if len(nomes_clientes) == 0:
            print("=== Nenhum cliente cadastrado (；′⌒`) ===")
        else:
            for i in range(len(nomes_clientes)):
                print(f"{i} - Nome: {nomes_clientes[i]}\nTelefone: {telefone_clientes[i]}\n")
        print()
    
    elif option == "3":
        print("\n3 - Editar cliente")
        if len(nomes_clientes) == 0:
            print("=== Nenhum cliente para editar (；′⌒`) ===")
        else:
            for i in range(len(nomes_clientes)):
                print(f"{i} - {nomes_clientes[i]}")
            
            try:
                indice = int(input("Digite o número do cliente que deseja editar:\n"))
                if indice < 0 or indice >= len(nomes_clientes):
                    print("=== ╰（‵□′）╯ ÍNDICE INVÁLIDO ╰（‵□′）╯ ===")
                else:
                    novo_nome = input("Novo nome (Enter para manter):\n")
                    novo_tel = input("Novo telefone (Enter para manter):\n")

                    if novo_nome != "":
                        nomes_clientes[indice] = novo_nome
                    if novo_tel != "":
                        telefone_clientes[indice] = novo_tel
                    
                    print("=== Cliente atualizado com sucesso! ☆*: .｡. o(≧▽≦)o .｡.:*☆ ===")
            except ValueError:
                print("=== ╰（‵□′）╯ Digite um número válido! ╰（‵□′）╯ ===")
            print()
            
    elif option == "4":
        print("\n4 - Excluir cliente")
        if len(nomes_clientes) == 0:
            print("=== Não há clientes para excluir (；′⌒`) ===")
        else:
            for i in range(len(nomes_clientes)):
                print(f"{i} - {nomes_clientes[i]}")
            
            try:
                indice = int(input("Digite o número do cliente que deseja excluir:\n"))
                if indice <0 or indice >= len(nomes_clientes):
                    print("=== ╰（‵□′）╯ ÍNDICE INVÁLIDO ╰（‵□′）╯ ===")
                else:
                    nomes_clientes.pop(indice)
                    telefone_clientes.pop(indice)
                    print("=== Cliente excluído com sucesso! ☆*: .｡. o(≧▽≦)o .｡.:*☆ ===")
            except ValueError:
                print("=== ╰（‵□′）╯ Digite um número válido! ╰（‵□′）╯ ===")
            print()

    elif option == "0":
        print("\n=== Programa encerrado ☆*: .｡. o(≧▽≦)o .｡.:*☆ ===")
    else:
        print("=== （︶^︶） Opção inválida. Tente novamente （︶^︶） === ")